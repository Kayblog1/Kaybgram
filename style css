@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;600;700&family=Syne:wght@700;800&display=swap');
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#09090b;--card:#121214;--card2:#1c1c1f;--border:#232326;--lime:#CCFF00;--muted:#a1a1aa}
body{background:var(--bg);color:#fafafa;font-family:'Geist',system-ui;padding-bottom:90px}
header{position:sticky;top:0;z-index:30;background:rgba(9,9,11,.9);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:14px 16px;display:flex;justify-content:space-between;align-items:center}
.logo{font-family:'Syne';font-weight:800;font-size:20px}.logo span{color:var(--lime)}
.badge{background:var(--card2);border:1px solid var(--border);padding:6px 12px;border-radius:100px;font-size:11px;color:var(--muted)}
.container{max-width:620px;margin:0 auto}
.create{background:var(--card);border:1px solid var(--border);border-radius:22px;margin:12px;padding:16px}
.file-drop{border:1.5px dashed var(--border);background:var(--card2);border-radius:16px;padding:22px;text-align:center;cursor:pointer}
.file-drop input{display:none}
.input{background:var(--card2);border:1px solid var(--border);color:#fff;padding:12px 14px;border-radius:12px;width:100%;outline:none;font-size:14px;margin-top:10px}
.btn{border:none;border-radius:100px;padding:13px;font-weight:800;cursor:pointer;width:100%;font-size:14px;margin-top:12px}
.btn-lime{background:var(--lime);color:#000;box-shadow:0 0 20px rgba(204,255,0,.3)}
.post{background:var(--card);border:1px solid var(--border);border-radius:22px;overflow:hidden;margin:12px}
.nav{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);background:rgba(20,20,22,.92);backdrop-filter:blur(24px);border:1px solid var(--border);border-radius:100px;padding:6px;display:flex;gap:4px;z-index:50}
.nav a{color:var(--muted);text-decoration:none;font-size:10px;font-weight:700;padding:9px 18px;border-radius:100px;display:flex;flex-direction:column;align-items:center}
.nav a.active{background:#fff;color:#000}
